NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional but recommended for local development
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/role-redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/role-redirect
# Optional overrides. By default the dashboard serves Clerk JS locally from /public/vendor/clerk-js/current.
NEXT_PUBLIC_CLERK_JS_URL=
NEXT_PUBLIC_CLERK_JS_VERSION=
# Optional: comma-separated emails forced as admin in dashboard UI role resolution.
# Example: DASHBOARD_ADMIN_EMAILS=alice@company.com,bob@company.com
DASHBOARD_ADMIN_EMAILS=

# Server-side proxy target for /api/auth/sync
BACKEND_API_URL=http://localhost:8000
# Public dashboard URL used by server-side routes that call back into the Next app.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional fallback used by some client calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_Y_WEBSOCKET_URL=ws://localhost:1234

# GitHub Webhooks Configuration
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Deprecated: Use NEXT_PUBLIC_APP_URL instead
GITHUB_WEBHOOK_URL=https://yourdomain.com/api/webhooks/github
