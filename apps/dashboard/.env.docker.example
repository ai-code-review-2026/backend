# ==========================================
# Dashboard Docker Environment Variables
# ==========================================
# Copy this file to .env.docker and fill in your values
# 
# Usage:
#   docker-compose -f docker-compose.dashboard.yml --env-file .env.docker up
# ==========================================

# ==========================================
# Docker Registry & Versioning
# ==========================================
DOCKER_REGISTRY=ahmedaminbejaoui
VERSION=latest

# ==========================================
# Service Ports
# ==========================================
DASHBOARD_PORT=3001
DASHBOARD_DEV_PORT=3001
BACKEND_PORT=8000
Y_WEBSOCKET_PORT=1234

# ==========================================
# Clerk Authentication (REQUIRED)
# ==========================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk URLs (optional - defaults provided)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/role-redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/role-redirect

# Optional: Custom Clerk JS hosting
NEXT_PUBLIC_CLERK_JS_URL=
NEXT_PUBLIC_CLERK_JS_VERSION=

# ==========================================
# Backend Connection
# ==========================================
# Server-side (Next.js API routes → FastAPI)
BACKEND_API_URL=http://backend:8000

# Client-side (browser → FastAPI)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Dashboard public URL
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ==========================================
# Real-time Collaboration (Y.js WebSocket)
# ==========================================
NEXT_PUBLIC_Y_WEBSOCKET_URL=ws://localhost:1234

# ==========================================
# GitHub Webhooks
# ==========================================
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# Admin Overrides (Optional)
# ==========================================
# Comma-separated emails forced as admin in dashboard UI
# Example: alice@company.com,bob@company.com
DASHBOARD_ADMIN_EMAILS=

# ==========================================
# Backend Fetch Timeouts (Optional)
# ==========================================
# Read timeout (default: 15s)
DASHBOARD_BACKEND_FETCH_TIMEOUT_MS=15000
# Write timeout (default: 30s)
DASHBOARD_BACKEND_WRITE_TIMEOUT_MS=30000

# ==========================================
# Backend Services (for full stack)
# ==========================================
DATABASE_URL=postgresql+psycopg://user:pass@postgres:5432/ai_code_review
REDIS_URL=redis://redis:6379/0
