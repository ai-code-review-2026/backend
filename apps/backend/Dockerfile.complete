################################################################################
# Multi-Stage Dockerfile for AI Code Review Platform Backend
# 
# This Dockerfile builds a production-ready FastAPI backend with:
# - Python 3.11 (slim base for minimal footprint)
# - Static analysis tools (Ruff, Semgrep, ESLint, Stylelint, RuboCop, Staticcheck)
# - ML/AI dependencies (sentence-transformers, langchain, neo4j)
# - Celery worker support for async analysis pipeline
# - Security hardening (non-root user, minimal attack surface)
# - Health checks and graceful shutdown support
#
# Build command:
#   docker build -f Dockerfile.complete -t ai-code-review-backend:latest .
#
# Run API server:
#   docker run -p 8000:8000 --env-file .env ai-code-review-backend:latest
#
# Run Celery worker:
#   docker run --env-file .env ai-code-review-backend:latest \
#     celery -A app.workers.celery_app worker -Q analyses --loglevel=info
################################################################################

################################################################################
# Stage 1: Base image with system dependencies
################################################################################
FROM python:3.11-slim AS base

# Metadata
LABEL maintainer="AI Code Review Platform Team"
LABEL description="FastAPI backend with Celery workers for AI-powered code review"
LABEL version="1.0.0"

# Prevent Python from writing .pyc files and buffering stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONHASHSEED=random

# Set locale to UTF-8 (important for text processing)
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Working directory
WORKDIR /app

# Install system dependencies in a single layer to minimize image size
# - git: Required for repository cloning and static analysis context
# - curl: For healthchecks and downloading binaries
# - build-essential: Required for compiling Python packages with C extensions
# - libpq-dev: PostgreSQL client library (required by psycopg)
# - ca-certificates: SSL/TLS certificate validation
# - nodejs/npm: For ESLint (JavaScript/TypeScript static analysis)
# - ruby/ruby-dev: For RuboCop (Ruby static analysis)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git=1:2.* \
    curl=7.* \
    build-essential=12.* \
    libpq-dev=15.* \
    ca-certificates=* \
    nodejs=18.* \
    npm=9.* \
    ruby=1:3.* \
    ruby-dev=1:3.* \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

################################################################################
# Stage 2: Install static analysis tools
################################################################################
FROM base AS tools

# Install Node.js static analysis tools globally
# - eslint: JavaScript/TypeScript linter
# - @eslint/js: Core ESLint config
# - stylelint: CSS/SCSS linter
RUN npm install -g --no-optional --no-audit --no-fund \
    eslint@^8.57.0 \
    @eslint/js@^8.57.0 \
    stylelint@^16.0.0 \
    stylelint-config-standard@^36.0.0 \
    && npm cache clean --force

# Install Ruby static analysis tools
# - rubocop: Ruby linter and formatter
RUN gem install rubocop --version '~> 1.50' --no-document

# Install Go staticcheck binary for Go static analysis
# Latest release from: https://github.com/dominikh/go-tools
RUN curl -sSfL \
    https://github.com/dominikh/go-tools/releases/download/2023.1.7/staticcheck_linux_amd64.tar.gz \
    | tar -xzf - -C /usr/local/bin --strip-components=1 staticcheck/staticcheck \
    && chmod +x /usr/local/bin/staticcheck \
    && staticcheck -version

################################################################################
# Stage 3: Python dependencies
################################################################################
FROM tools AS python-deps

# Poetry configuration
# - Don't create virtualenvs (we're in a container)
# - Don't ask interactive questions
# - Use parallel downloads
ENV POETRY_VERSION=1.8.3 \
    POETRY_HOME=/opt/poetry \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - \
    && ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry \
    && poetry --version

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install Python dependencies
# - Production dependencies only (no --dev)
# - No root package (--no-root) as we copy app code later
# - Install minio separately (not in poetry.lock but required)
RUN --mount=type=cache,target=/tmp/poetry_cache \
    poetry install --only main --no-interaction --no-ansi --no-root \
    && pip install --no-cache-dir minio==7.2.* \
    && pip list --format=columns

################################################################################
# Stage 4: Runtime application image
################################################################################
FROM python-deps AS runtime

# Create non-root user for security
# - UID/GID 1000 (common non-root user)
# - No password, no shell login
# - Home directory at /app
RUN groupadd -g 1000 appuser \
    && useradd -u 1000 -g appuser -s /bin/bash -m -d /home/appuser appuser \
    && mkdir -p /app/logs /app/tmp /app/analysis /app/imported_repo \
    && chown -R appuser:appuser /app

# Copy application code
# Note: .dockerignore excludes .venv, tests, .git, *.log, etc.
COPY --chown=appuser:appuser . /app/

# Ensure Python scripts installed by Poetry are in PATH
# This includes: ruff, semgrep, sqlfluff, alembic, celery
ENV PATH="/home/appuser/.local/bin:/usr/local/bin:${PATH}"

# Runtime environment variables (can be overridden at runtime)
ENV APP_ENV=production \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000 \
    WORKERS_COUNT=1 \
    WORKER_TIMEOUT=120 \
    GRACEFUL_TIMEOUT=30 \
    KEEP_ALIVE=5 \
    LOG_LEVEL=info

# Health check
# Checks /health endpoint every 30s (timeout 10s, 3 retries before unhealthy)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${APP_PORT}/health || exit 1

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Default command: Run FastAPI server with Uvicorn
# Override with docker-compose to run Celery worker instead
CMD ["sh", "-c", "\
    uvicorn app.main:app \
    --host ${APP_HOST} \
    --port ${APP_PORT} \
    --workers ${WORKERS_COUNT} \
    --timeout-keep-alive ${KEEP_ALIVE} \
    --log-level ${LOG_LEVEL} \
    --access-log \
    --use-colors \
"]

################################################################################
# Stage 5: Development image (optional)
################################################################################
FROM runtime AS development

USER root

# Install development dependencies
RUN poetry install --with dev --no-interaction --no-ansi --no-root

# Install additional dev tools
RUN pip install --no-cache-dir \
    pytest==8.* \
    pytest-asyncio==0.23.* \
    pytest-cov==5.* \
    httpx==0.27.* \
    ipython==8.*

# Switch back to appuser
USER appuser

# Development command: Run with hot reload
CMD ["sh", "-c", "\
    uvicorn app.main:app \
    --host ${APP_HOST} \
    --port ${APP_PORT} \
    --reload \
    --reload-dir /app/app \
    --log-level debug \
"]

################################################################################
# Stage 6: Celery Worker image
################################################################################
FROM runtime AS worker

# Worker-specific environment
ENV CELERY_POOL=prefork \
    CELERY_CONCURRENCY=2 \
    CELERY_MAX_TASKS_PER_CHILD=50 \
    CELERY_TASK_TIME_LIMIT=7200 \
    CELERY_TASK_SOFT_TIME_LIMIT=3600

# Health check for worker (check Redis connection)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD celery -A app.workers.celery_app inspect ping -d celery@$HOSTNAME || exit 1

# Run Celery worker
# - Queue: analyses (main analysis queue)
# - Concurrency: 2 (adjust based on CPU cores)
# - Pool: prefork (Windows: use solo pool via env var)
# - Autoscale: min=1, max=4
CMD ["sh", "-c", "\
    celery -A app.workers.celery_app worker \
    --pool=${CELERY_POOL} \
    --concurrency=${CELERY_CONCURRENCY} \
    --max-tasks-per-child=${CELERY_MAX_TASKS_PER_CHILD} \
    --time-limit=${CELERY_TASK_TIME_LIMIT} \
    --soft-time-limit=${CELERY_TASK_SOFT_TIME_LIMIT} \
    --queue=analyses \
    --loglevel=${LOG_LEVEL} \
    --autoscale=4,1 \
"]

################################################################################
# Build targets:
#
# docker build -f Dockerfile.complete --target runtime -t backend:latest .
# docker build -f Dockerfile.complete --target development -t backend:dev .
# docker build -f Dockerfile.complete --target worker -t backend:worker .
################################################################################
