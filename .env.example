################################################################################
# AI Code Review Platform - Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copier ce fichier vers .env: cp .env.example .env
# 2. Remplir TOUTES les valeurs marquées avec <VOTRE_VALEUR>
# 3. Ne JAMAIS commiter le fichier .env dans Git
#
################################################################################

################################################################################
# GENERAL CONFIGURATION
################################################################################

# Environment (development, staging, production)
ENV=production
NODE_ENV=production

# Logging
LOG_LEVEL=info

################################################################################
# DOMAINES (Pour production VPS uniquement)
################################################################################

# Domaine principal de l'application
APP_DOMAIN=<votre-domaine.com>

# Sous-domaines
API_DOMAIN=api.<votre-domaine.com>
YJS_DOMAIN=yjs.<votre-domaine.com>
GRAFANA_DOMAIN=grafana.<votre-domaine.com>
FLOWER_DOMAIN=flower.<votre-domaine.com>
MINIO_DOMAIN=minio.<votre-domaine.com>
STORAGE_DOMAIN=storage.<votre-domaine.com>

################################################################################
# POSTGRESQL DATABASE
################################################################################

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_code_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<MOT_DE_PASSE_SECURISE>

# URL de connexion complète (générée automatiquement)
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

################################################################################
# REDIS (Cache et Broker Celery)
################################################################################

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

################################################################################
# CELERY (Task Queue)
################################################################################

CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/1
ANALYSIS_QUEUE_NAME=analyses
CELERY_WORKER_POOL=prefork
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=50

################################################################################
# NEO4J (Graph Database pour GraphRAG)
################################################################################

NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<MOT_DE_PASSE_NEO4J>
NEO4J_DATABASE=neo4j

# Configuration mémoire Neo4j
NEO4J_HEAP_INITIAL=512M
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

################################################################################
# MINIO (Object Storage S3-compatible)
################################################################################

OBJECT_STORAGE_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<MOT_DE_PASSE_MINIO>
MINIO_BUCKET=ai-review-artifacts
MINIO_SECURE=false
MINIO_REGION=us-east-1

################################################################################
# SECURITY & ENCRYPTION
################################################################################

# Clé de chiffrement Fernet (générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRETS_ENCRYPTION_KEY=<GENERER_UNE_CLE_FERNET>

# Secret pour les webhooks GitHub
GITHUB_WEBHOOK_SECRET=<SECRET_ALEATOIRE>

# JWT Configuration
JWT_SECRET_KEY=<GENERER_UN_SECRET_JWT>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

################################################################################
# CLERK AUTHENTICATION
################################################################################

CLERK_AUTH_ENABLED=false
CLERK_SECRET_KEY=<sk_test_XXXX>
CLERK_ISSUER_URL=<https://clerk.votre-app.com>
CLERK_JWKS_URL=<https://clerk.votre-app.com/.well-known/jwks.json>
CLERK_AUDIENCE=<votre-audience>
CLERK_JWT_LEEWAY_SECONDS=10
CLERK_ORGANIZATIONS_ENFORCED=false
CLERK_WEBHOOK_SECRET=<whsec_XXXX>

# Frontend Clerk Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<pk_test_XXXX>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

################################################################################
# GITHUB INTEGRATION
################################################################################

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_ID=<ID_DE_VOTRE_APP_GITHUB>
GITHUB_APP_INSTALLATION_ID=<ID_INSTALLATION>
GITHUB_APP_PRIVATE_KEY_PEM=<CLE_PRIVEE_GITHUB_APP>
GITHUB_OAUTH_TOKEN=<ghp_XXXX>
GH_TOKEN=<ghp_XXXX>

################################################################################
# STATIC ANALYSIS CONFIGURATION
################################################################################

STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_GIT_TOKEN=${GITHUB_OAUTH_TOKEN}
STATIC_ANALYSIS_TIMEOUT_SECONDS=120
STATIC_ANALYSIS_MAX_FILES=200
STATIC_ANALYSIS_MAX_FINDINGS=200
STATIC_ANALYSIS_FILTER_CHANGED_LINES=true
STATIC_ANALYSIS_WORKSPACE_PATH=/var/ai-review/workspace
STATIC_ANALYSIS_CHECKOUT_BASE_PATH=/var/ai-review/workspace
REPO_CONTEXT_ALLOWED_ROOTS=/var/ai-review/workspace

################################################################################
# LLM PROVIDERS (OpenAI, Anthropic, Ollama)
################################################################################

LLM_ENABLED=true
LLM_PROVIDER=anthropic

# OpenAI
OPENAI_API_KEY=<sk-XXXX>
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.0

# Anthropic Claude
ANTHROPIC_API_KEY=<sk-ant-XXXX>
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=400

################################################################################
# REVIEW INTELLIGENCE (GraphRAG avec Neo4j)
################################################################################

REVIEW_INTELLIGENCE_ENABLED=true
REVIEW_INTELLIGENCE_REQUIRE_NEO4J=true

################################################################################
# EMAIL NOTIFICATIONS
################################################################################

EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=<SG.XXXX>
SENDGRID_FROM_EMAIL=noreply@votre-domaine.com
SENDGRID_FROM_NAME=AI Code Review Platform

# SMTP (Alternative à SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<votre-email@gmail.com>
SMTP_PASSWORD=<mot-de-passe-app>
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=<votre-email@gmail.com>

################################################################################
# SLACK NOTIFICATIONS
################################################################################

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=<https://hooks.slack.com/services/XXX>
SLACK_DEFAULT_CHANNEL=#code-review
SLACK_BOT_TOKEN=<xoxb-XXXX>

################################################################################
# MICROSOFT TEAMS NOTIFICATIONS
################################################################################

TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=<https://outlook.office.com/webhook/XXX>
TEAMS_DEFAULT_CHANNEL=Code Review

################################################################################
# PUSH NOTIFICATIONS (Web Push)
################################################################################

PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=<GENERER_AVEC_web-push>
VAPID_PRIVATE_KEY=<GENERER_AVEC_web-push>
VAPID_SUBJECT=mailto:admin@votre-domaine.com

################################################################################
# RBAC & PERMISSIONS
################################################################################

RBAC_ENFORCEMENT_ENABLED=true
ADMIN_EMAILS=admin@votre-domaine.com,admin2@votre-domaine.com
DASHBOARD_ADMIN_EMAILS=${ADMIN_EMAILS}

# GitHub Organization Access Control
ALLOWED_GITHUB_ORGS=votre-org,autre-org
ALLOWED_GITHUB_TEAMS=developers,reviewers
DASHBOARD_GITHUB_REQUIRE_ORG_CONTEXT=false
DASHBOARD_GITHUB_ENFORCE_OWNER_MATCH=false
DASHBOARD_GITHUB_TEAM_OWNER_MAP=

################################################################################
# CORS CONFIGURATION
################################################################################

CORS_ALLOWED_ORIGINS=https://${APP_DOMAIN},https://${API_DOMAIN}
CORS_ALLOW_CREDENTIALS=true

################################################################################
# DASHBOARD (Next.js Frontend)
################################################################################

# URLs publiques (utilisées par le navigateur)
NEXT_PUBLIC_API_URL=https://${APP_DOMAIN}
NEXT_PUBLIC_APP_URL=https://${APP_DOMAIN}
NEXT_PUBLIC_BACKEND_URL=https://${API_DOMAIN}
NEXT_PUBLIC_Y_WEBSOCKET_URL=wss://${YJS_DOMAIN}

# URL backend interne (communication serveur à serveur)
BACKEND_API_URL=http://backend:8000

# Dashboard Configuration
PORT=3001
DASHBOARD_BACKEND_FETCH_TIMEOUT_MS=15000
DASHBOARD_BACKEND_SYNC_TIMEOUT_MS=15000
DASHBOARD_BACKEND_WRITE_TIMEOUT_MS=30000
DASHBOARD_ALLOW_GLOBAL_GITHUB_TOKEN_FALLBACK=false

################################################################################
# MONITORING & OBSERVABILITY
################################################################################

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<MOT_DE_PASSE_GRAFANA>

# Flower (Celery Monitoring)
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=<MOT_DE_PASSE_FLOWER>

# Prometheus Pushgateway
PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091

################################################################################
# DEVELOPMENT ONLY (Ne pas utiliser en production)
################################################################################

# Hot Reload
WATCHPACK_POLLING=false
CHOKIDAR_USEPOLLING=false

# Debug
DEBUG=false
VERBOSE_LOGGING=false

################################################################################
# NOTES IMPORTANTES
################################################################################

# 1. Génération des clés de sécurité:
#    - SECRETS_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#    - JWT_SECRET_KEY: openssl rand -hex 32
#    - GITHUB_WEBHOOK_SECRET: openssl rand -hex 20
#    - VAPID Keys: npx web-push generate-vapid-keys
#
# 2. Mots de passe forts:
#    - Utiliser au minimum 16 caractères
#    - Mélanger majuscules, minuscules, chiffres et symboles
#    - Générateur: openssl rand -base64 24
#
# 3. Production:
#    - Ne JAMAIS utiliser les valeurs par défaut
#    - Activer HTTPS (MINIO_SECURE=true si derrière un proxy SSL)
#    - Activer RBAC_ENFORCEMENT_ENABLED=true
#    - Configurer les email/Slack pour les alertes
#
# 4. Backup:
#    - Sauvegarder régulièrement la base PostgreSQL
#    - Sauvegarder les volumes Neo4j et MinIO
#    - Conserver ce fichier .env dans un gestionnaire de secrets sécurisé
#
################################################################################
