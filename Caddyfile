################################################################################
# AI Code Review Platform - Caddyfile
# Reverse Proxy avec SSL automatique (Let's Encrypt)
#
# IMPORTANT: Remplacer <votre-domaine.com> par votre vrai domaine
################################################################################

# Configuration globale
{
    # Email pour Let's Encrypt (obligatoire pour SSL)
    email admin@<votre-domaine.com>
    
    # Staging Let's Encrypt (pour tests, désactiver en production)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
    
    # Production Let's Encrypt (activer en production)
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

################################################################################
# APPLICATION PRINCIPALE (Frontend Dashboard)
################################################################################
<votre-domaine.com> {
    # Logs
    log {
        output file /var/log/caddy/app.log
        level INFO
    }

    # Reverse proxy vers le dashboard Next.js
    reverse_proxy dashboard:3001 {
        # Headers de sécurité
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        
        # Timeouts pour Next.js
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
        }
    }

    # Headers de sécurité globaux
    header {
        # HSTS (force HTTPS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # Sécurité XSS
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        
        # CSP (Content Security Policy)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://clerk.*.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.clerk.accounts.dev wss://{host}"
        
        # Referrer
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # Permissions
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        
        # Remove server info
        -Server
    }

    # Compression
    encode gzip zstd

    # Limite de taille de requête (100MB pour uploads)
    request_body {
        max_size 100MB
    }
}

################################################################################
# API BACKEND
################################################################################
api.<votre-domaine.com> {
    log {
        output file /var/log/caddy/api.log
        level INFO
    }

    # Reverse proxy vers FastAPI backend
    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        
        # Timeouts pour API
        transport http {
            dial_timeout 10s
            response_header_timeout 120s
            read_timeout 180s
        }
        
        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 10s
    }

    # Headers de sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    # CORS headers (géré par FastAPI mais ajouté ici aussi)
    @options {
        method OPTIONS
    }
    handle @options {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        header Access-Control-Max-Age "3600"
        respond 204
    }

    encode gzip zstd
    
    request_body {
        max_size 100MB
    }
}

################################################################################
# YJS WEBSOCKET (Collaboration temps réel)
################################################################################
yjs.<votre-domaine.com> {
    log {
        output file /var/log/caddy/yjs.log
        level INFO
    }

    # Reverse proxy avec support WebSocket
    reverse_proxy yjs-server:1234 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        
        # WebSocket support
        header_up Connection {>Connection}
        header_up Upgrade {>Upgrade}
        
        transport http {
            dial_timeout 10s
            # Pas de timeout pour WebSocket
            read_timeout 0
            write_timeout 0
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
}

