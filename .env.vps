# ============================================
# VPS PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================

# --- General Config ---
ENV=production
BASE_URL=http://135.125.100.150:8000

# --- Database & Redis ---
DATABASE_URL=postgresql+psycopg://devora:devoradb2026@postgres:5432/devora
REDIS_URL=redis://redis:6379/0

# --- Clerk Backend Auth ---
CLERK_AUTH_ENABLED=false
ADMIN_EMAILS=bejaouiahmed053@gmail.com

# --- Celery & Background Tasks ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
ANALYSIS_QUEUE_NAME=analyses

# --- Secret Scanning ---
SECRET_SCAN_ENABLED=true
SECRET_SCAN_ENTROPY_THRESHOLD=3.8
SECRET_SCAN_MIN_TOKEN_LEN=20
PURGE_RAW_DIFF_AFTER_REDACTION=true
ALLOW_UNSAFE_DIFF_API=false

# --- Static Analysis ---
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_RUFF_ENABLED=true
STATIC_ANALYSIS_SEMGREP_ENABLED=true
STATIC_ANALYSIS_TIMEOUT_SECONDS=60
STATIC_ANALYSIS_MAX_FINDINGS=200
STATIC_ANALYSIS_FILTER_CHANGED_LINES=true

# ============================================
# LLM GATEWAY CONFIGURATION (NEW)
# ============================================

# Gateway Core
LLM_GATEWAY_ENABLED=true
LLM_ENABLED=true
LLM_PROVIDER=ollama

# Ollama (Local, Free - PRIMARY for CONFIDENTIAL data)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-coder:6.7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=2048

# Anthropic Claude (Premium, $3-$15/M tokens)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MAX_TOKENS=8192
# ANTHROPIC_TEMPERATURE=0.1

# OpenAI GPT (Cost-effective alternatives)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=4096

# Azure OpenAI (Enterprise)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
# AZURE_OPENAI_API_VERSION=2024-02-01

# Rate Limiting (requests per minute/hour)
RATE_LIMIT_ANTHROPIC_PER_MINUTE=50
RATE_LIMIT_OPENAI_PER_MINUTE=60
RATE_LIMIT_OLLAMA_PER_MINUTE=0
RATE_LIMIT_PER_USER_PER_HOUR=100

# Prompt Caching (~30% cost savings)
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL_SECONDS=3600
PROMPT_CACHE_MAX_SIZE=10000

# ============================================
# OBSERVABILITY CONFIGURATION (NEW)
# ============================================

# LLM Traces & Metrics
LLM_TRACES_RETENTION_DAYS=90
LLM_METRICS_AGGREGATION_INTERVAL_MINUTES=60

# Langfuse (LLMOps Dashboard - Optional)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_TIMEOUT_SECONDS=5
LANGFUSE_RETRY_COUNT=3

# OpenTelemetry (Distributed Tracing - Optional)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=devora-backend
OTEL_EXPORTER_TYPE=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SAMPLE_RATE=1.0
OTEL_RESOURCE_ATTRIBUTES=service.name=devora,service.version=1.0.0,deployment.environment=production

# ============================================
# MULTI-AGENT SYSTEM (NEW)
# ============================================

MULTI_AGENT_ENABLED=true
MULTI_AGENT_PARALLEL_EXECUTION=true
MULTI_AGENT_TIMEOUT_SECONDS=300
MULTI_AGENT_MAX_FINDINGS_PER_AGENT=50
MULTI_AGENT_DEDUPLICATION_ENABLED=true
MULTI_AGENT_SIMILARITY_THRESHOLD=0.85

# ============================================
# RAGAS EVALUATION (NEW)
# ============================================

RAGAS_EVALUATION_ENABLED=true
RAGAS_COMPUTE_ON_TRACE=true
RAGAS_USE_OLLAMA=true
RAGAS_BATCH_SIZE=10

# ============================================
# NEO4J GRAPHRAG
# ============================================

NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_ENABLED=true

# LangChain
LANGCHAIN_ENABLED=true
LANGCHAIN_OLLAMA_CHAT_MODEL_PRIMARY=deepseek-coder
LANGCHAIN_OLLAMA_CHAT_MODEL_FALLBACK=

# GraphRAG Features
KB_PRIORITY_ENABLED=true
AUTO_FIX_ENABLED=true
HISTORY_ENABLED=true
INCREMENTAL_INDEXING_ENABLED=true

# ============================================
# QDRANT (Optional - Disabled for Neo4j-only)
# ============================================

QDRANT_ENABLED=false
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_storage
QDRANT_URL=http://qdrant:6333
REVIEW_INTELLIGENCE_ENABLED=true
QDRANT_REPO_CONTEXT_COLLECTION=repo_context

# ============================================
# OBJECT STORAGE (MinIO)
# ============================================

OBJECT_STORAGE_ENABLED=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=ai-review-artifacts
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# NOTIFICATIONS
# ============================================

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#code-reviews

# Email (SendGrid)
EMAIL_ENABLED=false
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ============================================
# DASHBOARD (Next.js)
# ============================================

BACKEND_API_URL=http://backend:8000
NEXT_PUBLIC_BACKEND_URL=http://135.125.100.150:8000
DASHBOARD_BACKEND_FETCH_TIMEOUT_MS=15000
DASHBOARD_BACKEND_WRITE_TIMEOUT_MS=30000

# ============================================
# SECURITY
# ============================================

# Secrets Encryption (Fernet key - generate with: make generate-fernet-key)
SECRETS_ENCRYPTION_KEY=your-fernet-key-here

# RBAC
RBAC_ENFORCEMENT_ENABLED=false

# ============================================
# MONITORING
# ============================================

GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
